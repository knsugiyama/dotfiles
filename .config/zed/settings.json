{
  "format_on_save": "off",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "terminal": {
    "font_family": "PlemolJP Console NF",
    "font_size": 14,
    "working_directory": "current_project_directory"
  },
  "use_system_path_prompts": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "buffer_font_family": "PlemolJP Console NF",
  "buffer_font_size": 15,
  "soft_wrap": "editor_width",
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark"
  }
}
