### リポジトリ直下: 全て ignore し、管理対象だけ許可 ###
/*
!/.editorconfig
!/.gitconfig
!/.gitconfig_credential
!/.gitignore_global
!/.gitignore
!/.github/
!/hosts/
!/modules/
!/LICENSE
!/README.md
!/flake.nix
!/flake.lock
!/bootstrap.sh
!/setup.ps1
!/.config/

### .config: 直下を全て ignore し、管理対象のディレクトリだけ許可 ###
# (~/.config を丸ごと symlink しているため、アプリが勝手に作るフォルダが混入する)
/.config/*
!/.config/gh/
/.config/gh/hosts.yml
/.config/gh/config.yml
!/.config/hammerspoon/
!/.config/lazygit/
!/.config/nvim/
!/.config/sheldon/
!/.config/skk/
!/.config/zed/
/.config/zed/*
!/.config/zed/settings.json
!/.config/zed/keymap.json

### logs / junk ###
*.log

### OSX ###
*.DS_Store
.AppleDouble
.LSOverride
