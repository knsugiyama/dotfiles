;================================================================
; 初期設定 (v2.0 準拠)
;================================================================
#SingleInstance Force
SendMode "Input"

;================================================================
; キーボードレイアウト判定（最初に1回だけ実行）
;================================================================
isJISLayout := (DllCall("GetKeyboardLayout", "UInt", DllCall("GetWindowThreadProcessId", "Ptr", WinExist("A"), "UInt", 0)) & 0xFFFF) == 0x0411

;================================================================
; 左右Altキーの空打ちでIMEを切り替える
;================================================================
#HotIf !WinActive("ahk_exe msrdc.exe")

; Altキーが押された瞬間にメニューフォーカスを「予防」する
~LAlt:: Send "{Blind}{vkFF}"
~RAlt:: Send "{Blind}{vkFF}"

~LAlt Up:: {
    KeyWait "LAlt"
    if A_PriorKey == "LAlt" {
        Send "{vk1Dsc07B}" ; 無変換
    }
}

~RAlt Up:: {
    KeyWait "RAlt"
    if A_PriorKey == "RAlt" {
        Send "{vk1Csc079}" ; 変換
    }
}

;================================================================
; JIS配列キーボードをUS配列風にするためのキーリマップ
;================================================================
#HotIf isJISLayout
; --- 1キー段目 ---
sc029:: Send "{``}"    ; 半角/全角
+sc029:: Send "{~}"
+2:: Send "{@}"       ; Shift + 2         ["] -> @
+6:: Send "{^}"       ; Shift + 6         [&] -> ^
+7:: Send "{&}"       ; Shift + 7         ['] -> &
+8:: Send "{*}"       ; Shift + 8         [(] -> *
+9:: Send "{(}"       ; Shift + 9         [)] -> (
+0:: Send "{)}"       ; Shift + 0         [ ] -> )
+-:: Send "{_}"       ; Shift + -         [=] -> _
^:: Send "{=}"        ;                   [^] -> =
+^:: Send "{+}"       ; Shift + ^         [~] -> +

; Qキー段目
@:: Send "{[}"        ;                   [@] -> [
+@:: Send "{{}"       ; Shift + @         [`] -> {
[:: Send "{]}"        ;                   [[] -> ]
+[:: Send "{}}"       ; Shift + [         [{] -> }

; Aキー段目
+;:: Send "{:}"       ; Shift + ;         [+] -> :
::: Send "{'}"        ;                   [:] -> '
*:: Send '{"}'        ; Shift + :         [*] -> "

; --- Zキー段目 ---
+]:: Send "{|}"       ; Shift + ]         [}] -> |
]:: Send "{\}"        ;                   []] -> \

; すべてのHotIf条件をリセット
#HotIf
